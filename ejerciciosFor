Console.WriteLine("-----TABLAS DE MULTIPLICAR-----");

for (int i = 1; i<= 10; i++)
{
    Console.WriteLine($"Tabla de multiplicar del {i}");
    for (int j = 1; j <= 10; j++)
    {
       
        Console.WriteLine($"{i} x {j} = {i * j}");
    }
}

Console.WriteLine("-----NUMERO DEL 0 AL 100-----");
for (int k = 0; k <= 100; k++)
    
    {
    if (k % 2 == 0)
        Console.WriteLine(k + "= PAR");
    else
        Console.WriteLine(k + "= IMPAR");
}

Console.WriteLine("-----IMPRIMIR UN CUADRADO-----");
for (int l = 1; l <= 3; l++)
{
    for (int m = 1; m <= 3; m++)
    {
        Console.Write("* ");
    }
    Console.WriteLine();
}
